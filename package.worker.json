{
  "name": "umami-worker",
  "version": "1.0.0",
  "description": "Umami Analytics on Cloudflare Workers + D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply umami-db",
    "db:migrate:local": "wrangler d1 migrations apply umami-db --local",
    "db:create": "wrangler d1 create umami-db",
    "kv:create": "wrangler kv:namespace create KV",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "bcryptjs": "^2.4.3",
    "uuid": "^10.0.0",
    "zod": "^3.23.0",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "ua-parser-js": "^1.0.38"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/ua-parser-js": "^0.7.39",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.86.0"
  }
}
