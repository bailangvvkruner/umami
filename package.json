{
  "name": "umami-worker",
  "version": "1.0.0",
  "description": "Umami Analytics on Cloudflare Workers + D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute umami-db --remote --file=./migrations/0001_initial_schema.sql",
    "db:seed": "wrangler d1 execute umami-db --remote --file=./migrations/seed.sql",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/bcryptjs": "^2.4.6",
    "typescript": "^5.6.0",
    "wrangler": "^3.86.0"
  }
}
